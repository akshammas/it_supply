@@ -37,3 +37,56 @@ .listing-seo a {
 }
 
 .listing-seo a:hover { text-decoration: underline; }
+
+/* ===== "Need a quotation?" band (bottom of category / brand pages) ===== */
+.quote-cta {
+    background: var(--brand-red-light);
+    padding: 3.5rem 0;
+    margin-top: 3rem;
+}
+
+.quote-cta h2 {
+    font-weight: 800;
+    font-size: 1.8rem;
+    letter-spacing: -.01em;
+    margin-bottom: .75rem;
+}
+
+.quote-cta p { color: var(--muted); }
+
+.quote-cta .contact-list {
+    list-style: none;
+    margin: 0;
+    padding: 0;
+    display: grid;
+    gap: 1rem;
+}
+
+.quote-cta .contact-list li {
+    display: flex;
+    align-items: center;
+    gap: .9rem;
+}
+
+.quote-cta .contact-list i {
+    flex: 0 0 44px;
+    width: 44px;
+    height: 44px;
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    border-radius: 50%;
+    background: #fff;
+    color: var(--brand-red);
+    font-size: 1.15rem;
+    box-shadow: 0 4px 12px rgba(16, 24, 40, .08);
+}
+
+.quote-cta .contact-list a,
+.quote-cta .contact-list span {
+    color: var(--ink);
+    text-decoration: none;
+    font-weight: 500;
+}
+
+.quote-cta .contact-list a:hover { color: var(--brand-red); }
